{
  "manifest_version": 2,
  "name": "YouTube Click Recorder (MVP)",
  "version": "0.2",
  "description": "Enregistre chaque vidéo YouTube visitée : url, titre, miniature, heure de clic et de sortie.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "downloads"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_title": "YouTube History",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtu.be/*",
        "*://www.youtube-nocookie.com/*"
      ],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "history.html",
    "styles.css"
  ],
  "icons": {
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "@syllogene", 
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}

